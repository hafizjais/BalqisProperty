# Airtable — create a token at https://airtable.com/create/tokens
# with the data.records:read scope, granted access to this base.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Developer "Project" listings — the sheet/table id for the new-launch
# projects table (same base as above). See CONTENT-GUIDE.md for the columns
# this table needs.
AIRTABLE_PROJECT_TABLE_ID=

# Shop Lot and Land listings — dedicated sheets (same base as above).
# See CONTENT-GUIDE.md for the columns these tables need.
AIRTABLE_SHOPLOT_TABLE_ID=
AIRTABLE_LAND_TABLE_ID=
